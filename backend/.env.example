# Copy to .env and edit. Never commit the real .env.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/firemap_real   # a "@" in the password must be written %40
JWT_SECRET_KEY=change-me-to-a-long-random-string       # required in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
CORS_ORIGINS=http://localhost:5173                     # frontend address(es), comma separated; * only for local development
FLASK_ENV=development                                  # development | production
TILE_SERVER_URL=http://localhost:8000/tiles            # only used by heatmap format=tiles (stub)

# only for the daily pipeline / backfill jobs
FIRMS_MAP_KEY=
NDVI_DIR=
OPENMETEO_WIND_UNIT=ms
